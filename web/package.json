{
  "name": "office-r-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "office-R 的 Web 视图层(React + Vite + TS),通过 WASM 调用 Rust 计算内核",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:fixtures": "cd .. && cargo run -p xtask -- fixtures web/e2e/fixtures"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tengxiaohyx/office-shared": "workspace:*",
    "@tengxiaohyx/office-word": "workspace:*",
    "@tengxiaohyx/office-excel": "workspace:*",
    "@tengxiaohyx/office-ppt": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
