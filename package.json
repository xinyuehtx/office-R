{
  "name": "office-r-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "office-R monorepo:office-shared / office-word / office-excel / office-ppt + 演示站(web)",
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings 23",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -C web build",
    "dev": "pnpm -C web dev",
    "e2e": "pnpm -C web e2e",
    "e2e:fixtures": "cargo run -p xtask -- fixtures web/e2e/fixtures"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
